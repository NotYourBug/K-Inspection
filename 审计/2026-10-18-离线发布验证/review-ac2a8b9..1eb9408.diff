+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: k8s-inspector-prometheus-rules
+  namespace: kube-system
+data:
+  inspection-v2-shadow.yaml: "groups:\n- name: k8s-inspector-v2\n  rules:\n  - alert:\
+    \ K8sInspectorBusinessFailure\n    expr: max by (cluster, profile, rule_id, scope)\
+    \ ((last_over_time(inspector_last_valid_failures{profile=\"5m\",rule_id=\"nodes.ready\"\
+    ,scope=\"cluster\"}[30d])\n      > 0) or (last_over_time(inspector_confirmed_failures{profile=\"\
+    5m\",rule_id=\"nodes.ready\",scope=\"cluster\"}[30d])\n      > 0))\n    for: 1m\n\
+    \    labels:\n      shadow: 'true'\n      category: business\n      severity:\
+    \ critical\n      rule_id: nodes.ready\n      profile: 5m\n      scope: cluster\n\
+    \    annotations:\n      summary: 'Inspection finding: nodes.ready'\n      description:\
+    \ Last valid unhealthy observation; verify recovery using fresh evidence.\n  -\
+    \ alert: K8sInspectorBusinessFailure\n    expr: max by (cluster, profile, rule_id,\
+    \ scope) ((last_over_time(inspector_last_valid_failures{profile=\"5m\",rule_id=\"\
+    pods.current\",scope=\"cluster\"}[30d])\n      > 0) or (last_over_time(inspector_confirmed_failures{profile=\"\
+    5m\",rule_id=\"pods.current\",scope=\"cluster\"}[30d])\n      > 0))\n    for:\
+    \ 1m\n    labels:\n      shadow: 'true'\n      category: business\n      severity:\
+    \ critical\n      rule_id: pods.current\n      profile: 5m\n      scope: cluster\n\
+    \    annotations:\n      summary: 'Inspection finding: pods.current'\n      description:\
+    \ Last valid unhealthy observation; verify recovery using fresh evidence.\n  -\
+    \ alert: K8sInspectorBusinessFailure\n    expr: max by (cluster, profile, rule_id,\
+    \ scope) ((last_over_time(inspector_last_valid_failures{profile=\"5m\",rule_id=\"\
+    pvc.binding\",scope=\"cluster\"}[30d])\n      > 0) or (last_over_time(inspector_confirmed_failures{profile=\"\
